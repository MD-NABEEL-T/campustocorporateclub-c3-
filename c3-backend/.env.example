# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/c3db

# Authentication & Security
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=30d

# Owner Account Email (Owner-only promote/demote admin features)
OWNER_EMAIL=owner@c3club.org

# Allowed Frontend Origins (comma-separated for CORS and email links)
CLIENT_URL=http://localhost:5173

# Cloudinary (Media assets & uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# SMTP Email Configuration (Nodemailer - Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=your_email@gmail.com
SMTP_PASS=your_email_app_password
ADMIN_EMAIL=admin@c3club.org
