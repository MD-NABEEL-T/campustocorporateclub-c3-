diff --git a/c3-backend/models/GalleryPhoto.js b/c3-backend/models/GalleryPhoto.js
new file mode 100644
index 0000000..755f41e
--- /dev/null
+++ b/c3-backend/models/GalleryPhoto.js
@@ -0,0 +1,13 @@
+import mongoose from 'mongoose';
+
+// Curated "best photos" collection for the homepage Masonry section.
+// Completely independent from Event.gallery and Session.images - admin
+// hand-picks what goes here, it is never auto-populated from either.
+const galleryPhotoSchema = new mongoose.Schema({
+  image: { type: String, required: true },   // Cloudinary secure URL
+  publicId: { type: String, required: true }, // Cloudinary public_id, needed to delete the asset cleanly
+  caption: { type: String },
+  createdBy: { type: mongoose.Schema.Types.ObjectId, ref: 'User' },
+}, { timestamps: true });
+
+export default mongoose.model('GalleryPhoto', galleryPhotoSchema);
diff --git a/c3-backend/controllers/galleryController.js b/c3-backend/controllers/galleryController.js
new file mode 100644
index 0000000..dccdd4e
--- /dev/null
+++ b/c3-backend/controllers/galleryController.js
@@ -0,0 +1,55 @@
+import GalleryPhoto from '../models/GalleryPhoto.js';
+import cloudinary from '../config/cloudinary.js';
+
+// Create a curated Masonry photo - admin only. Single-image upload.
+export const createGalleryPhoto = async (req, res) => {
+  try {
+    if (!req.file) {
+      return res.status(400).json({ message: 'Image is required' });
+    }
+
+    const { caption } = req.body;
+
+    const photo = await GalleryPhoto.create({
+      image: req.file.path,       // Cloudinary secure URL
+      publicId: req.file.filename, // Cloudinary public_id (set by multer-storage-cloudinary)
+      caption,
+      createdBy: req.user._id,
+    });
+
+    res.status(201).json(photo);
+  } catch (err) {
+    res.status(500).json({ message: err.message });
+  }
+};
+
+// List all curated Masonry photos - public, no auth required.
+export const getGalleryPhotos = async (req, res) => {
+  try {
+    const photos = await GalleryPhoto.find()
+      .sort({ createdAt: -1 })
+      .select('image caption createdAt');
+
+    res.json(photos);
+  } catch (err) {
+    res.status(500).json({ message: err.message });
+  }
+};
+
+// Delete a curated Masonry photo - admin only. Removes both the MongoDB
+// record and the underlying Cloudinary asset so nothing is left orphaned.
+export const deleteGalleryPhoto = async (req, res) => {
+  try {
+    const photo = await GalleryPhoto.findById(req.params.id);
+    if (!photo) {
+      return res.status(404).json({ message: 'Photo not found' });
+    }
+
+    await cloudinary.uploader.destroy(photo.publicId);
+    await photo.deleteOne();
+
+    res.json({ message: 'Photo deleted' });
+  } catch (err) {
+    res.status(500).json({ message: err.message });
+  }
+};
diff --git a/c3-backend/routes/galleryRoutes.js b/c3-backend/routes/galleryRoutes.js
new file mode 100644
index 0000000..3f0c29c
--- /dev/null
+++ b/c3-backend/routes/galleryRoutes.js
@@ -0,0 +1,16 @@
+import express from 'express';
+import { protect, adminOnly } from '../middleware/authMiddleware.js';
+import upload from '../middleware/upload.js';
+import {
+  createGalleryPhoto,
+  getGalleryPhotos,
+  deleteGalleryPhoto,
+} from '../controllers/galleryController.js';
+
+const router = express.Router();
+
+router.get('/', getGalleryPhotos);
+router.post('/', protect, adminOnly, upload.single('image'), createGalleryPhoto);
+router.delete('/:id', protect, adminOnly, deleteGalleryPhoto);
+
+export default router;
